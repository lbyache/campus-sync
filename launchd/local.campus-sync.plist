<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla: scripts/install.sh reemplaza __HOME__, ajusta el horario con plutil y la copia a ~/Library/LaunchAgents.
  Frecuencia: semanal (domingo 10:00, por defecto) o diaria (08:00). Cada corrida dura uno o dos
  minutos y termina; no queda nada abierto.
  Si la Mac estaba dormida a esa hora, launchd la corre al despertar.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.campus-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/campus-sync</string>
        <string>sync</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/campus-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/campus-sync.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
